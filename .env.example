# Aptura — Environment Configuration (.env.example)
# Copy to .env and populate keys on the server only. Never expose keys to the browser.

# OpenServ SERV Reasoning API
# Docs: https://docs.openserv.ai/serv-reasoning/introduction
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Set a model supported by your SERV account.
SERV_MODEL=

# Reppo Evaluation API
# Docs: https://docs.reppo.ai/api/eval/overview
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz
REPPO_SETTLEMENT_MINUTES=15

# FastAPI Backend & SQLite Storage
# Omit storage overrides to use this repository's data directory.

APTURA_API_PORT=8000

# Next.js Frontend
APTURA_BACKEND_URL=http://127.0.0.1:8000

# Public deployment safety
# APTURA_PUBLIC=1 makes Reppo reviews require the x-aptura-admin-key header (they spend credits).
APTURA_PUBLIC=
APTURA_ADMIN_KEY=
# Max /api/v1/supervise calls per IP per minute (default 6)
APTURA_SUPERVISE_PER_MIN=
